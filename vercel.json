{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|favicon.svg|favicon.png)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:c5L2T3X0dG6Dk8wP1qJtZyMxBsVeNl9hR4cO2uP3zD8=",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie",
    "CACHE_DRIVER": "array",
    "VIEW_COMPILED_PATH": "/tmp",
    "APP_BOOTSTRAP_CACHE_PATH": "/tmp",
    "APP_PACKAGES_CACHE_PATH": "/tmp/packages.php",
    "APP_SERVICES_CACHE_PATH": "/tmp/services.php",
    "APP_CONFIG_CACHE_PATH": "/tmp/config.php",
    "APP_ROUTES_CACHE_PATH": "/tmp/routes.php",
    "APP_EVENTS_CACHE_PATH": "/tmp/events.php"
  }
}
